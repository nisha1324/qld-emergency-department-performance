// DAX measures for the Queensland ED performance Power BI model.
//
// How to use: in Power BI Desktop open DAX query view, paste this whole file
// and click Run. The EVALUATE queries at the end print the values to compare
// with powerbi/CHECKS.md. Then click "Update model with changes" to add every
// measure to the model (DEFINE MEASURE only lives in the query until then).
//
// Rules, the same as in the Python analysis:
//   * the source publishes percentages. The fact table holds head counts
//     (attendances x published rate), and every rate here is a ratio of sums:
//     DIVIDE ( SUM ( count ), SUM ( its base ) ). Never average a rate and
//     never sum a *_published column;
//   * each count has a base column next to it: the attendances of the rows
//     where the rate is known. Dividing by the base, not by attendances,
//     keeps a row with no rate out of both sides;
//   * the 4-hour rate of patients who were not admitted is implied by three
//     published figures, not published. Its measure says so in its name;
//   * a median cannot be rebuilt from parts, so the median wait is shown only
//     for one hospital in one quarter, as published;
//   * the scorecard verdicts (level, trend, streams) were computed in Python
//     with a chance test. They are columns of hospital_scorecard and are
//     counted here, not recalculated.
//
// Rates are fractions (0.561): format them as percentages. Columns of
// hospital_scorecard are already in percentage points (-8.2).

DEFINE

    // ---- Volumes ----------------------------------------------------------

    MEASURE fct_ed_triage_quarter[Attendances] =
        SUM ( fct_ed_triage_quarter[attendances] )
    MEASURE fct_ed_triage_quarter[Hospitals Reporting] =
        DISTINCTCOUNT ( fct_ed_triage_quarter[hospital_key] )
    MEASURE fct_ed_triage_quarter[Triage Share %] =
        DIVIDE (
            [Attendances],
            CALCULATE ( [Attendances], REMOVEFILTERS ( dim_triage ) )
        )

    // ---- Whole ED stay within 4 hours --------------------------------------

    MEASURE fct_ed_triage_quarter[Stays Within 4 Hours] =
        SUM ( fct_ed_triage_quarter[stays_within_4h] )
    MEASURE fct_ed_triage_quarter[Stays Over 4 Hours] =
        SUM ( fct_ed_triage_quarter[stays_4h_base] ) - [Stays Within 4 Hours]
    MEASURE fct_ed_triage_quarter[4-hour Stay %] =
        DIVIDE ( [Stays Within 4 Hours], SUM ( fct_ed_triage_quarter[stays_4h_base] ) )

    // ---- The two streams (Part 4) -----------------------------------------

    MEASURE fct_ed_triage_quarter[Admitted %] =
        DIVIDE (
            SUM ( fct_ed_triage_quarter[admitted] ),
            SUM ( fct_ed_triage_quarter[admitted_base] )
        )
    MEASURE fct_ed_triage_quarter[Admitted 4-hour Stay %] =
        DIVIDE (
            SUM ( fct_ed_triage_quarter[stream_admitted_within_4h] ),
            SUM ( fct_ed_triage_quarter[stream_admitted] )
        )
    MEASURE fct_ed_triage_quarter[Not Admitted 4-hour Stay % (implied)] =
        DIVIDE (
            SUM ( fct_ed_triage_quarter[stream_not_admitted_within_4h] ),
            SUM ( fct_ed_triage_quarter[stream_not_admitted] )
        )

    // ---- Front door --------------------------------------------------------

    // Rebuilt from the five categories. It runs about 0.3 points above the
    // published all-categories figure, so use it for changes, not levels.
    MEASURE fct_ed_triage_quarter[Seen On Time % (rebuilt)] =
        DIVIDE (
            SUM ( fct_ed_triage_quarter[seen_on_time] ),
            SUM ( fct_ed_triage_quarter[seen_on_time_base] )
        )
    MEASURE fct_ed_triage_quarter[Did Not Wait %] =
        DIVIDE ( SUM ( fct_ed_triage_quarter[did_not_wait] ), [Attendances] )
    MEASURE fct_ed_triage_quarter[Left After Treatment Started %] =
        DIVIDE ( SUM ( fct_ed_triage_quarter[left_after_treatment] ), [Attendances] )

    // One hospital, one quarter, all categories, as published. Blank for
    // anything wider: medians cannot be added up or averaged.
    MEASURE fct_hospital_quarter_published[Median Wait (minutes, published)] =
        IF (
            COUNTROWS ( fct_hospital_quarter_published ) = 1,
            MAX ( fct_hospital_quarter_published[median_wait_min] )
        )

    // ---- Same quarter a year earlier ---------------------------------------
    // Blank unless exactly one quarter is in context, and blank for the first
    // four quarters (no year-earlier quarter in the data).

    MEASURE fct_ed_triage_quarter[4-hour Stay % Year Earlier] =
        IF (
            HASONEVALUE ( dim_quarter[quarter_key] ),
            VAR ThisQuarter = MAX ( dim_quarter[quarter_index] )
            RETURN
                CALCULATE (
                    [4-hour Stay %],
                    REMOVEFILTERS ( dim_quarter ),
                    dim_quarter[quarter_index] = ThisQuarter - 4
                )
        )
    MEASURE fct_ed_triage_quarter[4-hour Stay Change On Year (points)] =
        VAR Earlier = [4-hour Stay % Year Earlier]
        RETURN
            IF ( NOT ISBLANK ( Earlier ), ( [4-hour Stay %] - Earlier ) * 100 )
    MEASURE fct_ed_triage_quarter[Attendances Year Earlier] =
        IF (
            HASONEVALUE ( dim_quarter[quarter_key] ),
            VAR ThisQuarter = MAX ( dim_quarter[quarter_index] )
            RETURN
                CALCULATE (
                    [Attendances],
                    REMOVEFILTERS ( dim_quarter ),
                    dim_quarter[quarter_index] = ThisQuarter - 4
                )
        )
    MEASURE fct_ed_triage_quarter[Attendances Change On Year %] =
        VAR Earlier = [Attendances Year Earlier]
        RETURN
            IF ( NOT ISBLANK ( Earlier ), DIVIDE ( [Attendances] - Earlier, Earlier ) )

    // ---- The scorecard's two comparison quarters ---------------------------
    // dim_quarter[comparison_role] marks them: "start" and "latest".

    MEASURE fct_ed_triage_quarter[4-hour Stay % Start] =
        CALCULATE (
            [4-hour Stay %],
            REMOVEFILTERS ( dim_quarter ),
            dim_quarter[comparison_role] = "start"
        )
    MEASURE fct_ed_triage_quarter[4-hour Stay % Latest] =
        CALCULATE (
            [4-hour Stay %],
            REMOVEFILTERS ( dim_quarter ),
            dim_quarter[comparison_role] = "latest"
        )
    MEASURE fct_ed_triage_quarter[4-hour Stay Change Start To Latest (points)] =
        VAR StartRate = [4-hour Stay % Start]
        RETURN
            IF ( NOT ISBLANK ( StartRate ), ( [4-hour Stay % Latest] - StartRate ) * 100 )

    // ---- Published headline, for comparison --------------------------------

    MEASURE state_published_quarter[Queensland 4-hour Stay % (published)] =
        IF (
            COUNTROWS ( state_published_quarter ) = 1,
            MAX ( state_published_quarter[stay_within_4h_pct] ) / 100
        )

    // ---- Scorecard counts (verdicts computed in Python) --------------------

    MEASURE hospital_scorecard[Hospitals Scored] =
        COUNTROWS ( hospital_scorecard )
    MEASURE hospital_scorecard[Hospitals Slipping] =
        CALCULATE ( COUNTROWS ( hospital_scorecard ), hospital_scorecard[trend] = "slipping" )
    MEASURE hospital_scorecard[Hospitals Improving] =
        CALCULATE ( COUNTROWS ( hospital_scorecard ), hospital_scorecard[trend] = "improving" )
    MEASURE hospital_scorecard[Hospitals No Clear Change] =
        CALCULATE ( COUNTROWS ( hospital_scorecard ), hospital_scorecard[trend] = "no clear change" )
    MEASURE hospital_scorecard[Hospitals Below Peers And Slipping] =
        CALCULATE (
            COUNTROWS ( hospital_scorecard ),
            hospital_scorecard[below_peers_and_slipping] = TRUE ()
        )
    MEASURE hospital_scorecard[Hospitals With Wait Step] =
        CALCULATE ( COUNTROWS ( hospital_scorecard ), hospital_scorecard[wait_step] = TRUE () )

// ---------------------------------------------------------------------------
// Check queries. Each one matches a section of powerbi/CHECKS.md.
// ---------------------------------------------------------------------------

// 1. Queensland by quarter
EVALUATE
SUMMARIZECOLUMNS (
    dim_quarter[quarter_key],
    dim_quarter[quarter_label],
    "hospitals", [Hospitals Reporting],
    "attendances", [Attendances],
    "4-hour stays", [4-hour Stay %],
    "published", [Queensland 4-hour Stay % (published)],
    "admitted", [Admitted %],
    "did not wait", [Did Not Wait %]
)
ORDER BY dim_quarter[quarter_key]

// 2. Peer groups at the two comparison quarters
EVALUATE
SUMMARIZECOLUMNS (
    dim_hospital[peer_group_sort],
    dim_hospital[peer_group_label],
    dim_quarter[quarter_key],
    dim_quarter[quarter_label],
    TREATAS ( { "start", "latest" }, dim_quarter[comparison_role] ),
    "hospitals", [Hospitals Reporting],
    "attendances", [Attendances],
    "4-hour stays", [4-hour Stay %],
    "admitted", [Admitted %],
    "admitted: 4-hour stays", [Admitted 4-hour Stay %],
    "not admitted: 4-hour stays (implied)", [Not Admitted 4-hour Stay % (implied)]
)
ORDER BY dim_hospital[peer_group_sort], dim_quarter[quarter_key]

// 3. Triage categories, latest quarter
EVALUATE
SUMMARIZECOLUMNS (
    dim_triage[triage_key],
    dim_triage[triage_label],
    TREATAS ( { "latest" }, dim_quarter[comparison_role] ),
    "attendances", [Attendances],
    "share", [Triage Share %],
    "4-hour stays", [4-hour Stay %],
    "admitted", [Admitted %],
    "seen on time (rebuilt)", [Seen On Time % (rebuilt)]
)
ORDER BY dim_triage[triage_key]

// 4. Change on the same quarter a year earlier
EVALUATE
FILTER (
    SUMMARIZECOLUMNS (
        dim_quarter[quarter_key],
        dim_quarter[quarter_label],
        "4-hour stays", [4-hour Stay %],
        "year earlier", [4-hour Stay % Year Earlier],
        "change (points)", [4-hour Stay Change On Year (points)],
        "attendances change", [Attendances Change On Year %]
    ),
    NOT ISBLANK ( [year earlier] )
)
ORDER BY dim_quarter[quarter_key]

// 5. Scorecard counts by peer group
EVALUATE
SUMMARIZECOLUMNS (
    dim_hospital[peer_group_sort],
    dim_hospital[peer_group_label],
    "hospitals", [Hospitals Scored],
    "slipping", [Hospitals Slipping],
    "no clear change", [Hospitals No Clear Change],
    "improving", [Hospitals Improving],
    "below peers and slipping", [Hospitals Below Peers And Slipping],
    "wait step", [Hospitals With Wait Step]
)
ORDER BY dim_hospital[peer_group_sort]

// 6. Large hospitals below peers and slipping
EVALUATE
SUMMARIZECOLUMNS (
    dim_hospital[hospital_name],
    TREATAS ( { "large" }, dim_hospital[peer_group] ),
    TREATAS ( { TRUE () }, hospital_scorecard[below_peers_and_slipping] ),
    "4-hour stays, start", [4-hour Stay % Start],
    "4-hour stays, latest", [4-hour Stay % Latest],
    "change (points)", [4-hour Stay Change Start To Latest (points)],
    "within category (points)", MAX ( hospital_scorecard[within_category_effect] ),
    "slipping in", MAX ( hospital_scorecard[slipping_pattern] )
)
ORDER BY [within category (points)]

// 7. A blank that means zero (Oct-Dec 2023)
EVALUATE
SUMMARIZECOLUMNS (
    dim_hospital[hospital_name],
    TREATAS ( { 202312 }, dim_quarter[quarter_key] ),
    TREATAS ( { "Capricorn Coast", "Cunnamulla", "Dirranbandi" }, dim_hospital[hospital_name] ),
    "attendances", [Attendances],
    "admitted", [Admitted %],
    "admitted if blank rows are dropped",
        DIVIDE (
            SUM ( fct_ed_triage_quarter[admitted] ),
            CALCULATE (
                SUM ( fct_ed_triage_quarter[attendances] ),
                KEEPFILTERS ( NOT ISBLANK ( fct_ed_triage_quarter[admitted_pct_published] ) )
            )
        ),
    "published",
        DIVIDE ( SUM ( fct_hospital_quarter_published[admitted_pct] ), 100 )
)
ORDER BY dim_hospital[hospital_name]

// 8. Totals
EVALUATE
ROW (
    "fact rows", COUNTROWS ( fct_ed_triage_quarter ),
    "attendances, all quarters", [Attendances],
    "stays over 4 hours, all quarters", [Stays Over 4 Hours],
    "did not wait, all quarters", SUM ( fct_ed_triage_quarter[did_not_wait] ),
    "hospitals", COUNTROWS ( dim_hospital ),
    "quarters", COUNTROWS ( dim_quarter )
)
